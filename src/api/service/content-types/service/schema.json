{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "short_description": {
      "type": "string",
      "required": true
    },
    "long_description": {
      "type": "blocks",
      "required": true
    },
    "cover_photo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "pricing": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Retainer",
        "Fixed",
        "Milestone-based"
      ]
    },
    "track": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::track.track",
      "inversedBy": "services"
    },
    "order": {
      "type": "integer"
    },
    "tags": {
      "type": "json"
    },
    "is_differentiator": {
      "type": "boolean",
      "default": false
    },
    "faqs": {
      "type": "component",
      "component": "content.faq-item",
      "repeatable": true
    }
  }
}
